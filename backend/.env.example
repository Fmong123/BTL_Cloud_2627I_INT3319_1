# Default: upload returns 503 until a storage adapter is configured.
MAYSEC_STORAGE_MODE=unconfigured
# Explicit local HTTP demo: set MAYSEC_STORAGE_MODE=local (not Amazon S3).
# Relative paths resolve against backend/, not the shell working directory.
MAYSEC_LOCAL_STORAGE_DIR=data
MAYSEC_MAX_FILE_SIZE_BYTES=104857600
MAYSEC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The app.main:app entrypoint already connects Sang's uploader.
# Set MAYSEC_STORAGE_MODE=s3 and supply the actual bucket/region below.
S3_BUCKET_NAME=
AWS_REGION=
MAYSEC_S3_MULTIPART_THRESHOLD_BYTES=16777216
MAYSEC_S3_MULTIPART_CHUNKSIZE_BYTES=8388608
# SDK transfer concurrency per upload, not simultaneous HTTP requests.
MAYSEC_S3_MAX_CONCURRENCY=2
# Metadata configuration only; upload DB operations are not connected yet.
# Keep disabled by default so the existing storage modes still work.
MAYSEC_METADATA_MODE=disabled
# DynamoDB uses Sydney independently of the S3 AWS_REGION above.
DYNAMODB_REGION=ap-southeast-2
DYNAMODB_FILES_TABLE=securedrive-files
DYNAMODB_AUDIT_TABLE=securedrive-audit-log
DYNAMODB_USERS_TABLE=securedrive-users
# AWS credentials are resolved by Boto3; never commit real credentials here.
