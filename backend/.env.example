# BACKEND: copy file này thành backend/.env nếu chưa có; không ghi đè .env đang dùng.
# .env.example chỉ là mẫu. Từ backend/, chạy để nạp .env:
# .\.venv\Scripts\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --env-file .env
# Biến $env:... trong terminal ưu tiên hơn .env. Đổi cấu hình cần restart backend.
# Trong file dùng TEN_BIEN=gia_tri, không dùng cú pháp $env:TEN_BIEN = '...' của PowerShell.

# CHỌN CÁCH CHẠY: sửa các dòng tương ứng bên dưới, không thêm nhiều dòng trùng tên.
# A. Local không AWS: MAYSEC_STORAGE_MODE=local, MAYSEC_METADATA_MODE=disabled,
#    MAYSEC_SCAN_PIPELINE_ENABLED=false.
# B. Test hiện tại: file local + DynamoDB thật:
#    MAYSEC_STORAGE_MODE=local, MAYSEC_METADATA_MODE=dynamodb, MAYSEC_SCAN_PIPELINE_ENABLED=false.
# C. S3 + DynamoDB: MAYSEC_STORAGE_MODE=s3, MAYSEC_METADATA_MODE=dynamodb;
#    điền S3_BUCKET_NAME và AWS_REGION thật.
#    Chỉ bật MAYSEC_SCAN_PIPELINE_ENABLED=true sau khi writer DB của Lambda đã sẵn sàng.

# AWS trên máy phát triển: tên profile đã tạo bằng aws configure --profile securedrive-key.
# Viết đúng AWS_PROFILE (chữ hoa), không phải AWS_Profile. Đây không phải access key.
# Boto3 tự đọc biến này; không cần thêm AWS_PROFILE vào Settings của app.
# Credentials nằm ở %USERPROFILE%\.aws\credentials; không dán key/secret vào project.
# Profile phải tồn tại khi bật DynamoDB hoặc S3; đổi tên nếu máy bạn dùng profile khác.
# Khi triển khai dùng IAM role, bỏ dòng AWS_PROFILE, không ép profile local lên server.
AWS_PROFILE=securedrive-key

# LƯU NỘI DUNG FILE: unconfigured | local | s3.
# Giữ mặc định unconfigured để chưa nhận upload (503); đổi thành local cho cách A/B.
MAYSEC_STORAGE_MODE=unconfigured
# Đường dẫn tương đối tính từ backend/: data/uploads/<owner_id>/<file_id>/<tên-file>.
MAYSEC_LOCAL_STORAGE_DIR=data
# 104857600 byte = 100 MiB; đồng bộ với VITE_MAX_FILE_SIZE_MB=100 ở frontend.
MAYSEC_MAX_FILE_SIZE_BYTES=104857600
# Origin frontend được phép gọi API; nếu đổi cổng frontend thì cập nhật danh sách này.
MAYSEC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# METADATA/AUDIT: disabled = không ghi DB, list/status trả 503; dynamodb = ghi DB thật.
MAYSEC_METADATA_MODE=disabled
# Pipeline yêu cầu storage=s3 + metadata=dynamodb. Local luôn để false.
# Cờ này điều khiển trạng thái khởi tạo, không tạo hoặc bật/tắt trigger EventBridge AWS.
MAYSEC_SCAN_PIPELINE_ENABLED=false
# DynamoDB cố định Sydney; mọi tên bảng phải bắt đầu securedrive-.
DYNAMODB_REGION=ap-southeast-2
DYNAMODB_FILES_TABLE=securedrive-files
DYNAMODB_AUDIT_TABLE=securedrive-audit-log
DYNAMODB_USERS_TABLE=securedrive-users

# S3: chỉ cần khi MAYSEC_STORAGE_MODE=s3; local có thể để trống.
# AWS_REGION là region bucket S3, độc lập DYNAMODB_REGION; không đoán region của bucket.
S3_BUCKET_NAME=
AWS_REGION=
# Giữ các giá trị SDK này khi chưa cần tối ưu: ngưỡng 16 MiB, chunk 8 MiB.
MAYSEC_S3_MULTIPART_THRESHOLD_BYTES=16777216
MAYSEC_S3_MULTIPART_CHUNKSIZE_BYTES=8388608
# Số tác vụ SDK song song cho mỗi upload; không phải số HTTP request đồng thời.
MAYSEC_S3_MAX_CONCURRENCY=2

# AWS CLI không tự đọc backend/.env; nếu kiểm CLI, chỉ định --profile securedrive-key.
# Tài liệu: https://docs.aws.amazon.com/boto3/latest/guide/configuration.html
