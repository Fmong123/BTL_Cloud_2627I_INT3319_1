# MAYSEC LAUNCHER — BẢN MẪU ENV ĐẦY ĐỦ
# File tham khảo: launcher KHÔNG tự đọc launcher/.env hoặc launcher/.env.example.
# Chép riêng phần BACKEND vào backend/.env, phần FRONTEND vào frontend/.env.local.
# Chỉ tạo file nếu chưa có; nếu đã có, cập nhật các biến cần dùng, tránh trùng tên.
# Chế độ chạy và port chọn qua menu launcher, không có biến LAUNCHER_MODE/PORT.
# Giá trị mẫu bên dưới dùng Local không AWS; xem README.md cùng thư mục để đổi chế độ.
# Cú pháp KEY=value; không dùng ${...}; đổi ENV cần khởi động lại dịch vụ.

# ==================== BEGIN BACKEND ====================
# Lưu file: local | s3 | unconfigured (chưa nhận upload).
# Launcher ghi đè biến này theo chế độ chọn tại menu 2.
MAYSEC_STORAGE_MODE=local
# Thư mục tương đối tính từ backend/; có thể dùng đường dẫn tuyệt đối.
MAYSEC_LOCAL_STORAGE_DIR=data
# Giới hạn mỗi tệp: 100 MB = 100.000.000 byte, tối đa 100 MB.
# Menu 3 → 3 ưu tiên hơn ENV; launcher đồng bộ giới hạn sang frontend.
MAYSEC_MAX_FILE_SIZE_BYTES=100000000
# Các origin được gọi API, phân cách bằng dấu phẩy, không thêm đường dẫn.
# Launcher bổ sung localhost và 127.0.0.1 với port frontend đã chọn.
MAYSEC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Metadata: disabled | dynamodb. Launcher ghi đè theo chế độ menu 2.
# disabled không ghi DB; API danh sách/trạng thái file trả 503.
MAYSEC_METADATA_MODE=disabled
# Region DynamoDB của project bắt buộc ap-southeast-2 khi bật metadata.
DYNAMODB_REGION=ap-southeast-2
# Tên ba bảng đã triển khai, phải bắt đầu bằng securedrive-.
DYNAMODB_FILES_TABLE=securedrive-files
DYNAMODB_AUDIT_TABLE=securedrive-audit-log
DYNAMODB_USERS_TABLE=securedrive-users

# Auth: dev để thử Local không cần token; cognito để xác minh access token.
# Khi chọn S3 + DynamoDB, PHẢI đổi thành cognito (launcher không tự đổi dev).
MAYSEC_AUTH_MODE=dev
# Quyền của danh tính phát triển khi auth=dev: user | admin.
MAYSEC_DEV_ROLE=user
# Chỉ cần khi auth=cognito: điền User Pool ID và App client ID thật.
# User Pool ID có dạng ap-southeast-2_AbCdEf123; region lấy từ tiền tố ID.
# App client ID cần khớp VITE_COGNITO_APP_CLIENT_ID phía frontend.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Bộ chọn tài khoản demo, khác với chế độ Demo chỉ giao diện của launcher.
# true yêu cầu auth=cognito, User Pool và quyền AWS đọc người dùng Cognito.
# Người truy cập bộ chọn có thể chọn cả tài khoản admin; mặc định tắt.
MAYSEC_DEMO_LOGIN_ENABLED=false
# Secret ký phiên demo: tùy chọn, chuỗi ngẫu nhiên >=32 ký tự, CHỈ ở backend.
# Để trống: backend tự tạo khóa, phiên demo hết hiệu lực sau khi restart.
# Không dùng một secret mẫu cố định và không commit giá trị thật.
MAYSEC_DEMO_SIGNING_KEY=

# Tên profile AWS đã tạo trên máy; không phải Account ID hoặc access key.
# Cần khi chọn Local + DynamoDB / S3 + DynamoDB; Local thường để trống.
# Ví dụ: AWS_PROFILE=securedrive-key. Có thể chọn bằng menu 5.
AWS_PROFILE=
# Bucket nguồn và region S3 thật; chỉ bắt buộc trong chế độ S3.
S3_BUCKET_NAME=
AWS_REGION=
# Bucket cách ly của pipeline, dùng khi xóa vĩnh viễn bản cách ly.
MAYSEC_QUARANTINE_BUCKET_NAME=
# Ngưỡng SDK chuyển sang multipart: 16 MiB = 16.777.216 byte.
MAYSEC_S3_MULTIPART_THRESHOLD_BYTES=16777216
# Mỗi phần multipart: 8 MiB; backend cho phép từ 5 MiB đến 5 GiB.
MAYSEC_S3_MULTIPART_CHUNKSIZE_BYTES=8388608
# Số tác vụ SDK song song cho mỗi upload, số nguyên dương.
MAYSEC_S3_MAX_CONCURRENCY=2

# Chỉ bật khi S3 + DynamoDB và hạ tầng quét/Lambda writer đã sẵn sàng.
# Cờ điều khiển trạng thái khởi tạo trong app, không bật/tắt trigger trên AWS.
# Launcher luôn ép false ở các chế độ khác S3 + DynamoDB.
MAYSEC_SCAN_PIPELINE_ENABLED=false
# ARN Step Functions STANDARD quét lại ở Sydney, không kèm alias/version.
# Ví dụ định dạng: arn:aws:states:ap-southeast-2:123456789012:stateMachine:securedrive-rescan
# Để trống nếu chưa triển khai; launcher bỏ ARN hiệu lực khi pipeline tắt.
MAYSEC_RESCAN_STATE_MACHINE_ARN=
# ==================== END BACKEND ====================

# ==================== BEGIN FRONTEND ====================
# demo = mô phỏng trên trình duyệt; api = gọi backend.
# Launcher tự đặt demo cho Demo, api cho ba chế độ còn lại.
VITE_UPLOAD_MODE=api
# URL gốc API, không thêm /docs hoặc /upload.
# Launcher ghi đè theo port API trong menu 3 → 2.
VITE_API_BASE_URL=http://127.0.0.1:8000
# MB thập phân, tối đa 100; launcher đồng bộ với giới hạn byte backend.
VITE_MAX_FILE_SIZE_MB=100
# Địa chỉ đăng nhập Cognito, ví dụ https://your-domain.auth.ap-southeast-2.amazoncognito.com.
# Điền khi dùng đăng nhập Cognito thông thường; Local dev không cần.
VITE_COGNITO_DOMAIN=
# App client ID công khai, khớp COGNITO_APP_CLIENT_ID; không phải client secret.
# Để trống khi Local dev; mã frontend hiện có fallback ID của project.
VITE_COGNITO_APP_CLIENT_ID=
# Để trống: tự dùng origin trình duyệt + /callback.
# Khi dùng Cognito, URL thực tế phải có trong danh sách callback được phép.
VITE_COGNITO_REDIRECT_URI=
# Để trống: tự dùng origin trình duyệt; cần có trong danh sách sign-out được phép.
VITE_COGNITO_LOGOUT_URI=
# ==================== END FRONTEND ====================

# AWS NÂNG CAO — chỉ đặt trong terminal trước khi mở launcher nếu cần.
# KHÔNG chép vào frontend; launcher không đọc các biến này từ file ENV.
# Dùng đường dẫn thật của máy bạn; nếu bỏ qua thì AWS dùng vị trí mặc định.
# PowerShell: $env:AWS_CONFIG_FILE = 'C:/Users/your-user/.aws/config'
# AWS_CONFIG_FILE=C:/Users/your-user/.aws/config
# AWS_SHARED_CREDENTIALS_FILE=C:/Users/your-user/.aws/credentials
# AWS_LOGIN_CACHE_DIRECTORY=C:/Users/your-user/.aws/login/cache
# AWS_CA_BUNDLE=C:/path/to/organization-ca.pem
# Launcher giữ bốn biến đường dẫn này cho AWS CLI/backend, loại khỏi frontend.
# AWS_EC2_METADATA_DISABLED=true, AWS_PAGER trống và AWS_CLI_AUTO_PROMPT=off
# do launcher tự đặt. Không cần khai báo access key/secret/session token ở đây:
# launcher dùng profile và loại các biến credentials AWS khỏi server con.
