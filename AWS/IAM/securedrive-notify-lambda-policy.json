{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishSns",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-southeast-2:018913575473:securedrive-notifications"
    },
    {
      "Sid": "AuditLog",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:018913575473:table/securedrive-audit-log"
    },
    {
      "Sid": "FileDeliveryState",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:018913575473:table/securedrive-files"
    }
  ]
}
