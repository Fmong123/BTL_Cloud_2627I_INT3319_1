{
  "Comment": "MaySec: existing metadata, version-pinned scan/quarantine, owner audit, SNS notification delivery",
  "QueryLanguage": "JSONata",
  "StartAt": "RouteOperation",
  "States": {
    "RouteOperation": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.recovery.action = 'retry_quarantine' %}",
          "Next": "RecoveryQuarantine"
        },
        {
          "Condition": "{% $states.input.recovery.action = 'retry_notification' %}",
          "Next": "RecoveryNotify"
        },
        {
          "Condition": "{% $exists($states.input.recovery) %}",
          "Next": "InvalidRecovery"
        }
      ],
      "Default": "ScanFilePII"
    },
    "RecoveryQuarantine": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": 1000,
      "Arguments": {
        "FunctionName": "securedrive-quarantine-file",
        "Payload": "{% $merge([$states.input, {'ctx': {'execution': $states.context.Execution.Id, 'entered_at': $states.context.State.EnteredTime}}]) %}"
      },
      "Output": "{% $states.result.Payload %}",
      "End": true,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $merge([$states.input, {'error': $states.errorOutput}]) %}",
          "Next": "QuarantineFailed"
        }
      ]
    },
    "RecoveryNotify": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "TimeoutSeconds": 1000,
      "Arguments": {
        "FunctionName": "securedrive-notify",
        "Payload": "{% $merge([$states.input, {'ctx': {'execution': $states.context.Execution.Id, 'entered_at': $states.context.State.EnteredTime}}]) %}"
      },
      "Output": "{% $states.result.Payload %}",
      "End": true
    },
    "InvalidRecovery": {
      "Type": "Fail",
      "Error": "InvalidRecoveryOperation"
    },
    "ScanFilePII": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "securedrive-scan-pii",
        "Payload": "{% $merge([$states.input, {'ctx': {'execution': $states.context.Execution.Id, 'entered_at': $states.context.State.EnteredTime}}]) %}"
      },
      "Output": "{% $merge([$states.input, {'scan': $states.result.Payload}]) %}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $merge([$states.input, {'scan_failure': true}]) %}",
          "Next": "RecordNotScanned"
        }
      ],
      "Next": "Route"
    },
    "Route": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $states.input.scan.status = 'flagged' %}",
          "Next": "QuarantineFile"
        },
        {
          "Condition": "{% $states.input.scan.status = 'safe' %}",
          "Next": "NotifySafe"
        },
        {
          "Condition": "{% $states.input.scan.status = 'unscanned' or $states.input.scan.status = 'error' %}",
          "Next": "Done"
        }
      ],
      "Default": "RecordNotScanned"
    },
    "QuarantineFile": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "securedrive-quarantine-file",
        "Payload": "{% $merge([$states.input, {'ctx': {'execution': $states.context.Execution.Id, 'entered_at': $states.context.State.EnteredTime}}]) %}"
      },
      "Output": "{% $merge([$states.input, {'quarantine': $states.result.Payload}]) %}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Output": "{% $merge([$states.input, {'error': $states.errorOutput}]) %}",
          "Next": "QuarantineFailed"
        }
      ],
      "Next": "NotifyQuarantined"
    },
    "NotifyQuarantined": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "securedrive-notify",
        "Payload": "{% {'result': 'quarantined', 'key': $states.input.detail.object.key, 'owner_id': $states.input.scan.owner_id, 'file_id': $states.input.scan.file_id, 'source_version_id': $states.input.scan.source_version_id, 'ctx': {'execution': $states.context.Execution.Id, 'entered_at': $states.context.State.EnteredTime}} %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "NotifySafe": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "securedrive-notify",
        "Payload": "{% {'result': 'safe', 'key': $states.input.detail.object.key, 'owner_id': $states.input.scan.owner_id, 'file_id': $states.input.scan.file_id, 'source_version_id': $states.input.scan.source_version_id, 'ctx': {'execution': $states.context.Execution.Id, 'entered_at': $states.context.State.EnteredTime}} %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "RecordNotScanned": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "securedrive-scan-pii",
        "Payload": "{% $merge([$states.input, {'ctx': {'execution': $states.context.Execution.Id, 'entered_at': $states.context.State.EnteredTime}, 'operation': 'record_failure'}]) %}"
      },
      "Output": "{% $merge([$states.input, {'scan': $states.result.Payload}]) %}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "Route",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ScanFailedEnd"
        }
      ]
    },
    "QuarantineFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "securedrive-quarantine-file",
        "Payload": "{% $merge([$states.input, {'ctx': {'execution': $states.context.Execution.Id, 'entered_at': $states.context.State.EnteredTime}, 'operation': 'record_failure'}]) %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Next": "QuarantineFailedEnd",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "PersistQuarantineFailure",
          "Output": "{% $states.input %}"
        }
      ]
    },
    "QuarantineFailedEnd": {
      "Type": "Fail",
      "Error": "QuarantineFailed",
      "Cause": "Quarantine did not complete or persistence was not confirmed; inspect metadata. Copy failure keeps flagged; failed deletion remains quarantine_delete_failed."
    },
    "Done": {
      "Type": "Succeed"
    },
    "ScanFailedEnd": {
      "Type": "Fail",
      "Error": "ScanPersistenceFailed",
      "Cause": "Cannot confirm scan result and audit. Inspect CloudWatch and metadata before retrying."
    },
    "PersistQuarantineFailure": {
      "Type": "Task",
      "Comment": "Independent of the failed Lambda. Atomically record an unconfirmed quarantine and its audit without altering scan findings or S3 objects.",
      "Resource": "arn:aws:states:::aws-sdk:dynamodb:transactWriteItems",
      "Arguments": {
        "ClientRequestToken": "{% $substring($states.context.Execution.Name, 0, 36) %}",
        "TransactItems": [
          {
            "Update": {
              "TableName": "securedrive-files",
              "Key": {
                "owner_id": {
                  "S": "{% $states.input.scan.owner_id %}"
                },
                "file_id": {
                  "S": "{% $states.input.scan.file_id %}"
                }
              },
              "UpdateExpression": "SET #step = :failed, status_reason = :reason, quarantine_reason = :reason, updated_at = :at, status_time = :order",
              "ConditionExpression": "attribute_exists(owner_id) AND #status = :flagged AND (attribute_not_exists(#step) OR #step = :pending) AND #execution = :execution AND source_version_id = :version AND upload_bucket = :bucket AND #key = :key AND (attribute_not_exists(lifecycle_state) OR lifecycle_state = :active)",
              "ExpressionAttributeNames": {
                "#step": "quarantine_status",
                "#status": "status",
                "#execution": "execution_id",
                "#key": "key"
              },
              "ExpressionAttributeValues": {
                ":failed": {
                  "S": "failed"
                },
                ":reason": {
                  "S": "quarantine_failed"
                },
                ":flagged": {
                  "S": "flagged"
                },
                ":pending": {
                  "S": "pending"
                },
                ":active": {
                  "S": "active"
                },
                ":at": {
                  "S": "{% $states.context.State.EnteredTime %}"
                },
                ":order": {
                  "S": "{% $states.context.State.EnteredTime & '#' & $states.input.scan.file_id %}"
                },
                ":execution": {
                  "S": "{% $states.context.Execution.Id %}"
                },
                ":version": {
                  "S": "{% $states.input.scan.source_version_id %}"
                },
                ":bucket": {
                  "S": "{% $states.input.detail.bucket.name %}"
                },
                ":key": {
                  "S": "{% $states.input.detail.object.key %}"
                }
              }
            }
          },
          {
            "Put": {
              "TableName": "securedrive-audit-log",
              "ConditionExpression": "attribute_not_exists(event_key)",
              "Item": {
                "file_id": {
                  "S": "{% $states.input.scan.file_id %}"
                },
                "owner_id": {
                  "S": "{% $states.input.scan.owner_id %}"
                },
                "event_key": {
                  "S": "{% $states.context.State.EnteredTime & '#workflow-quarantine-failed#' & $states.context.Execution.Name %}"
                },
                "occurred_at": {
                  "S": "{% $states.context.State.EnteredTime %}"
                },
                "action": {
                  "S": "quarantine_failed"
                },
                "actor": {
                  "S": "stepfunctions:securedrive-scan-pipeline"
                },
                "status": {
                  "S": "flagged"
                },
                "to_status": {
                  "S": "flagged"
                },
                "execution_id": {
                  "S": "{% $states.context.Execution.Id %}"
                },
                "details": {
                  "M": {
                    "reason": {
                      "S": "quarantine_failed"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDb.TransactionCanceledException"
          ],
          "Next": "QuarantineFailedEnd"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "QuarantineFailurePersistenceFailed"
        }
      ],
      "Next": "QuarantineFailedEnd"
    },
    "QuarantineFailurePersistenceFailed": {
      "Type": "Fail",
      "Error": "QuarantineFailurePersistenceFailed",
      "Cause": "Both Lambda and independent failure persistence are unavailable. Check workflow DynamoDB permissions and reconcile metadata before retrying quarantine."
    }
  }
}
